xcrun clang++ -Iinclude -I../core/include -O2 -g -std=c++17 -Wall -Wextra -Wpedantic -Werror -mmacosx-version-min=13.0 -arch x86_64 -fobjc-arc -MMD -MP -c src/WindowPresentationController.mm -o "build-unit4-window-x86/WindowPresentationController.o"
xcrun clang++ -Iinclude -I../core/include -O2 -g -std=c++17 -Wall -Wextra -Wpedantic -Werror -mmacosx-version-min=13.0 -arch x86_64 -fobjc-arc tests/test_window_presentation.mm build-unit4-window-x86/WindowPresentationController.o -arch x86_64 -framework AppKit -o "build-unit4-window-x86/test_window_presentation"
